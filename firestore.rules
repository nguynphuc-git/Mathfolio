rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
match /users/{uid}/documents/{documentId} {
function owner() { return request.auth != null && request.auth.uid == uid; }
allow read, delete: if owner();
allow create: if owner()
&& request.resource.data.keys().hasAll(['id', 'title', 'storagePath', 'size', 'contentType', 'subject', 'createdAt'])
&& request.resource.data.keys().hasOnly(['id', 'title', 'storagePath', 'size', 'contentType', 'subject', 'createdAt'])
&& request.resource.data.id == documentId
&& request.resource.data.storagePath == 'users/' + uid + '/documents/' + documentId + '/original'
&& request.resource.data.title is string
&& request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
&& request.resource.data.size is int
&& request.resource.data.size > 0 && request.resource.data.size <= 10 * 1024 * 1024
&& request.resource.data.contentType in ['application/pdf', 'text/markdown', 'text/plain']
&& request.resource.data.subject in ['calculus', 'discrete', 'algorithms']
&& request.resource.data.createdAt == request.time;
allow update: if false;
}
// Optional extension: private notes, not a public exam repository.
match /users/{uid}/notes/{noteId} {
allow read, delete: if request.auth != null && request.auth.uid == uid;
allow create, update: if request.auth != null && request.auth.uid == uid
&& request.resource.data.keys().hasOnly(['title', 'markdown', 'updatedAt'])
&& request.resource.data.title is string
&& request.resource.data.title.size() <= 200
&& request.resource.data.markdown is string
&& request.resource.data.markdown.size() <= 30000
&& request.resource.data.updatedAt == request.time;
}
match /{document=**} { allow read, write: if false; }
}
}
