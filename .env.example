# Firebase Web app configuration: identifies your project, not a server secret.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
# Public reCAPTCHA Enterprise site key; never put a secret key here.
VITE_RECAPTCHA_SITE_KEY=REPLACE_ME
# Development only: true generates a browser-local App Check debug token.
# Safelist that generated token in the Firebase console. Do not commit it.
VITE_APPCHECK_DEBUG=true
# Pick a currently supported model available to YOUR project.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
